{
  "name": "DigiPathFinder",
  "version": "1.0.0",
  "description": "A standalone version of the DigiPathFinder",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "author": "The Shadow Knight",
  "license": "ISC",
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.36",
    "child_process": "^1.0.2",
    "csv-parse": "^5.5.5",
    "decode-dxt": "^1.0.1",
    "electron-squirrel-startup": "^1.0.0",
    "jimp": "^0.22.12",
    "parse-dds": "^1.2.1",
    "xhr": "^2.6.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.3.0",
    "@electron-forge/maker-deb": "^7.3.0",
    "@electron-forge/maker-rpm": "^7.3.0",
    "@electron-forge/maker-squirrel": "^7.3.0",
    "@electron-forge/maker-zip": "^7.3.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.3.0",
    "@electron-forge/plugin-fuses": "^7.3.0",
    "electron": "^29.1.4"
  },
  "build": {
    "extraResources": [
      "./DSCSTools",
	  "./DSTSTools",
      "./game_data",
	  "./game_data_TS"
    ]
  },
  "packagerConfig": {
    "ignore": [
        "^\\/public$",
        "^\\/src$",
        "^\\/node_modules$",
        "^\\/[.].+",
		"^\\/game_data\\/packed$",
		"^\\/game_data\\/unpacked$",
		"^\\/game_data\\/game_data_TS$",
		"^\\/game_data\\/game_data_TS\\/main$",
		"^\\/game_data\\/game_data_TS\\/txt_.*$",
		"^\\/game_data\\/game_data_TS\\/img\\/.*\\.dds$"
		]
	}
}
